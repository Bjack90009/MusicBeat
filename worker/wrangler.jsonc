{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "music-beat-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:4202,http://localhost:4202"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music-beat-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
